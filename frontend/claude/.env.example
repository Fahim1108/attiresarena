# Local staging only. Never put operator/service-role secrets in this application.
CLAUDE_DESIGN_PREVIEW=1
SUPABASE_URL=https://jwccyndyaamodxjtjtfo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# For a LOCAL optimized Preview server only; Vercel sets VERCEL_ENV automatically.
# VERCEL_ENV=preview
# Enable ONLY after explicit approval, applying migration 20261030000300 to Staging,
# and verifying its real Auth/RLS/RPC behavior. Never enable for Production.
STAGING_GENERIC_DRAFT_EDITOR=0
# Requires Staging migration 20261030000400 and real gallery verification.
STAGING_PRODUCT_GALLERY=0
# Requires Staging migration 20261030000500 and integration verification.
STAGING_VARIANT_MANAGEMENT=0
# Requires Staging migration 20261030000600 and integration verification.
STAGING_CATALOGUE_TAXONOMY=0
# Real checkout orders. Requires Staging migrations 20261113000100 and 20261113000200
# and their verification. Never enable for Production.
STAGING_CHECKOUT_ORDERS=0
# Real checkout orders on Production. Production scope ONLY in Vercel, never on
# Preview, and only with the production database flag orders_enabled flipped on
# by the owner. The staging flag above never enables production.
# PRODUCTION_CHECKOUT_ORDERS=0
# Server-only trusted credential for checkout RPCs. NEVER prefix with NEXT_PUBLIC_ and never
# expose it to the browser. Only the pinned project URL for the active path (Staging or
# Production) is used; any other URL is refused.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin for customer-auth redirects (Google sign-in, email
# confirmation, password reset). Owner-set per environment; never commit
# a value. Must be a clean origin: https, no path/query/fragment (http
# loopback allowed in development only). Auth actions fail honestly
# when it is missing or invalid; the Host header is never used.
# Add SITE_URL + /auth/callback to the Supabase Auth redirect allowlist
# for the matching project (staging Preview URL, then production).
SITE_URL=
# Steadfast courier API keys for one-tap courier booking from the admin
# panel. Server-only: NEVER prefix with NEXT_PUBLIC_, never commit values,
# set them in Vercel env vars only. Steadfast has NO SANDBOX: every
# booking made with live keys is a real parcel. When unset, the courier
# panel shows "not configured" and no booking can be made.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Google Analytics Data API read-back for the Total Visitors graph.
# Server-only: NEVER prefix with NEXT_PUBLIC_, never commit values,
# set them in Vercel env vars only. The service account needs Viewer
# on the GA4 property and the Analytics Data API enabled in its GCP
# project. GA_SERVICE_ACCOUNT_PRIVATE_KEY is the PEM from the service
# account JSON key, pasted with its \n escapes intact. When unset or
# invalid, the graph shows its honest unavailable state.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=
